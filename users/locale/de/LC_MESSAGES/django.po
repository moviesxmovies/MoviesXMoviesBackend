"Du kannst die E-Mail zum Zurücksetzen des Passworts in {remaining_time} "
"Sekunden erneut senden"

#: users/views.py:468
msgid "Password reset email sent"
msgstr "E-Mail zum Zurücksetzen des Passworts gesendet"

#: users/views.py:493 users/views.py:504
msgid "Invalid verification code"
msgstr "Ungültiger Verifizierungscode"

#: users/views.py:501
