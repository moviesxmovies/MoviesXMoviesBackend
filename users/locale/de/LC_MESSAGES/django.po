#: users/templates/users/email/base.html:116
#, python-format
msgid "Hello, %(name)s!"
msgstr "Hallo, %(name)s!"

#: users/templates/users/email/base.html:122
msgid "MoviesXMovies Team. Cinema for everyone."
msgstr "MoviesXMovies Team. Kino für alle."

#: users/templates/users/email/password-reset-email.html:4
msgid "We have received a password reset request for your account:"
msgstr ""
"Wir haben eine Anfrage zum Zurücksetzen des Passworts für dein Konto "
"erhalten:"

#: users/templates/users/email/password-reset-email.html:5
msgid "This code is private and will expire soon."
msgstr "Dieser Code ist privat und läuft bald ab."

#: users/templates/users/email/password-reset-email.html:7
msgid "Reset Password"
msgstr "Passwort zurücksetzen"

#: users/templates/users/email/password-reset-email.html:11
msgid "If you did not request a password reset, you can ignore this email."
msgstr ""
"Wenn du keine Passwortzurücksetzung angefordert hast, kannst du diese E-Mail "
"ignorieren."

#: users/templates/users/email/verification-email.html:4
msgid ""
"Thank you for joining our film community. To complete your registration, "
"enter the following code:"
msgstr ""
"Danke, dass du unserer Filmgemeinschaft beigetreten bist. Um deine "
"Registrierung abzuschließen, gib folgenden Code ein:"

#: users/templates/users/email/verification-email.html:8
msgid "Your security code"
msgstr "Dein Sicherheitscode"

#: users/templates/users/email/verification-email.html:13
msgid "Verify Account"
msgstr "Konto verifizieren"

#: users/templates/users/email/verification-email.html:18
msgid "If you did not create an account, you can ignore this email."
msgstr "Wenn du kein Konto erstellt hast, kannst du diese E-Mail ignorieren."

#: users/views.py:202
msgid "Verification code is incorrect"
msgstr "Der Verifizierungscode ist falsch"

#: users/views.py:229
msgid "User is already verified"
msgstr "Der Benutzer ist bereits verifiziert"

#: users/views.py:236
#, python-brace-format
msgid "You can resend the verification email in {remaining_time} seconds"
msgstr ""
"Du kannst die Verifizierungs-E-Mail in {remaining_time} Sekunden erneut "
"senden"

#: users/views.py:243
msgid "Verification email resent"
msgstr "Verifizierungs-E-Mail erneut gesendet"

#: users/views.py:454 users/views.py:845
msgid "User not found"
msgstr "Benutzer nicht gefunden"

#: users/views.py:461
