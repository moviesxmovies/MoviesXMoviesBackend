#: users/templates/users/email/base.html:116
#, python-format
msgid "Hello, %(name)s!"
msgstr "Bonjour, %(name)s !"

#: users/templates/users/email/base.html:122
msgid "MoviesXMovies Team. Cinema for everyone."
msgstr "Équipe MoviesXMovies. Le cinéma pour tous."

#: users/templates/users/email/password-reset-email.html:4
msgid "We have received a password reset request for your account:"
msgstr ""
"Nous avons reçu une demande de réinitialisation du mot de passe pour votre "
"compte :"

#: users/templates/users/email/password-reset-email.html:6
msgid "Your security code"
msgstr "Votre code de sécurité"

#: users/templates/users/email/password-reset-email.html:9
msgid "This code is private and will expire soon."
msgstr "Ce code est privé et expirera bientôt."

#: users/templates/users/email/password-reset-email.html:11
msgid "Reset Password"
msgstr "Réinitialiser le mot de passe"

#: users/templates/users/email/password-reset-email.html:15
msgid "If you did not request a password reset, you can ignore this email."
msgstr ""
"Si vous n'avez pas demandé de réinitialisation du mot de passe, vous pouvez "
"ignorer cet e-mail."

#: users/templates/users/email/verification-email.html:4
msgid ""
"Thank you for joining our film community. To complete your registration, "
"enter the following code:"
msgstr ""
"Merci de rejoindre notre communauté cinéphile. Pour finaliser votre "
"inscription, entrez le code suivant :"

#: users/templates/users/email/verification-email.html:11
msgid "Verify Account"
msgstr "Vérifier le compte"

#: users/templates/users/email/verification-email.html:16
msgid "If you did not create an account, you can ignore this email."
msgstr "Si vous n'avez pas créé de compte, vous pouvez ignorer cet e-mail."

#: users/views.py:197
msgid "Verification code is incorrect"
msgstr "Le code de vérification est incorrect"

#: users/views.py:224
msgid "User is already verified"
msgstr "L'utilisateur est déjà vérifié"

#: users/views.py:231
#, python-brace-format
msgid "You can resend the verification email in {remaining_time} seconds"
msgstr ""
"Vous pouvez renvoyer l'e-mail de vérification dans {remaining_time} secondes"

#: users/views.py:238
msgid "Verification email resent"
msgstr "E-mail de vérification renvoyé"

#: users/views.py:444
msgid "User not found"
msgstr "Utilisateur introuvable"

#: users/views.py:451
#, python-brace-format
msgid "You can resend the password reset email in {remaining_time} seconds"
msgstr ""
"Vous pouvez renvoyer l'e-mail de réinitialisation du mot de passe dans "
"{remaining_time} secondes"

#: users/views.py:458
msgid "Password reset email sent"
msgstr "E-mail de réinitialisation du mot de passe envoyé"

#: users/views.py:483 users/views.py:494
msgid "Invalid verification code"
msgstr "Code de vérification invalide"

#: users/views.py:491
msgid "Password reset successful"
msgstr "Mot de passe réinitialisé avec succès"

#: users/views.py:666
msgid "Invalid language code"
msgstr "Code de langue invalide"

#: users/views.py:836
msgid "You cannot friend yourself"
msgstr "Vous ne pouvez pas être ami avec vous-même"

#: users/views.py:840
msgid "Already friends"
msgstr "Vous êtes déjà amis"

#: users/views.py:848 users/views.py:854
msgid "Friend request sent"
msgstr "Demande d'ami envoyée"

#: users/views.py:861
msgid "Friend request accepted"
msgstr "Demande d'ami acceptée"

#: users/views.py:863
msgid "Friend request already sent"
msgstr "Demande d'ami déjà envoyée"

#: users/views.py:880
msgid "You cannot unfriend yourself"
msgstr "Vous ne pouvez pas supprimer vous-même de vos amis"

#: users/views.py:890
msgid "No friend relationship to reject"
msgstr "Aucune relation d'amitié à rejeter"

#: users/views.py:894
msgid "Friend request rejected"
msgstr "Demande d'ami rejetée"

